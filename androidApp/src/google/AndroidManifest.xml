<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Firebase Analytics merges these in, but ADID collection is off and nothing reads the advertising ID. Play's
      advertising ID declaration must say "No" while they stay removed.
    -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <application
        android:name="org.meshtastic.app.GoogleMeshUtilApplication"
        tools:replace="android:name">
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/app_metadata" />

        <!--
          Android Auto messaging through notifications only. Adding <uses name="template" /> or any androidx.car.app
          service is a different, Closed-track-only program; Play rejects those on Open and Production.
        -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!--
          Register as an "Open in / Send to Meshtastic" target for GeoJSON/KML map files (e.g. the Meshtastic Site
          Planner's "Send to App" share). Google flavor only — it's the flavor that renders map overlays. Merged into
          the MainActivity declared in the base manifest. application/json is broad, but the map importer validates the
          file extension and ignores anything that isn't a supported layer.
        -->
        <activity
            android:name="org.meshtastic.app.MainActivity"
            tools:node="merge">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/geo+json" />
                <data android:mimeType="application/vnd.geo+json" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/vnd.google-earth.kml+xml" />
                <data android:mimeType="application/vnd.google-earth.kmz" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/geo+json" />
                <data android:mimeType="application/vnd.geo+json" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/vnd.google-earth.kml+xml" />
                <data android:mimeType="application/vnd.google-earth.kmz" />
            </intent-filter>
        </activity>

        <!-- Generated by the AppFunctions compiler from BaseMeshtasticAppFunctionService. -->
        <service
            android:name="org.meshtastic.app.ai.appfunctions.MeshtasticAppFunctionService"
            android:exported="true"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions"
                android:value="meshtastic_app_function_service-v1.xml" />
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="meshtastic_app_function_service.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
