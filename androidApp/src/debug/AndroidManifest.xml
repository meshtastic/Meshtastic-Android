<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          The automation entry point: MainActivity honours its launch switches only when started through this alias.
          DUMP is held by the shell and never by an installed app, so `adb shell am start` and UiAutomation can use it
          and nothing else on the device can.
        -->
        <activity-alias
            android:name="org.meshtastic.app.AutomationLauncher"
            android:targetActivity="org.meshtastic.app.MainActivity"
            android:permission="android.permission.DUMP"
            android:exported="true" />
    </application>

</manifest>
