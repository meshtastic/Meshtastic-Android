<!--
    updatePeriodMillis is the platform minimum: a node that goes quiet sends no update of its own, so this is what
    dims the widget once the node passes the app's online window.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:label="@string/widget_node_tracker_label"
    android:configure="org.meshtastic.feature.widget.NodeTrackerConfigActivity"
    android:widgetFeatures="reconfigurable"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/widget_node_tracker_preview"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
